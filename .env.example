# Local development defaults to sample capture. This does not email the club.
HAKUBA_ENQUIRY_MODE=local
# Production MUST use an explicit exact public origin. Do not enable local mode in production.
# HAKUBA_PUBLIC_ORIGIN=https://hakuba-karate.co.uk
# Private server-side store, outside public/ and dist/. Default: .local/enquiries
# HAKUBA_DATA_DIR=/absolute/private/path/enquiries
# For an operator-approved installed mail transport (not used by local capture):
# HAKUBA_ENQUIRY_MODE=sendmail
# HAKUBA_SENDMAIL_PATH=/absolute/path/to/sendmail
# HAKUBA_ENQUIRY_FROM=verified-sender@example.org
# HAKUBA_ENQUIRY_TO_WROUGHTON=approved-inbox@example.org
# HAKUBA_ENQUIRY_TO_MEVAGISSEY=approved-inbox@example.org
# HAKUBA_ENQUIRY_TO_GENERAL=approved-inbox@example.org
# Existing WordPress upstream, with the new bridge installed after separate approval.
# HAKUBA_WORDPRESS_ORIGIN=https://your-approved-wordpress-upstream.example
