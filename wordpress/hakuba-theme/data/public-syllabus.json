  {
    "id": "8th-kyu",
    "grade": "8th Kyu",
    "colour": "Yellow",
    "source": "https://hakuba-karate.co.uk/wp-content/uploads/2018/09/8thKyu_YellowBelt_Syllabus.pdf",
    "pdf": "/resources/syllabus/8th-kyu.pdf",
    "sections": [
      {
        "title": "Grading notes",
        "blocks": [
          "Commands on this grading will be given first in Japanese then in English.",
          "For 8th Kyu, you will also be tested on your belt-tying technique."
        ]
      },
      {
        "title": "KIHON-WAZA (Fundamental techniques)",
        "blocks": [
          "1.   Junzuki, Mawatte-jodan-uke: Straight punch, turn with head block.",
          "2.   Gyakuzuki, Mawatte-gedan-barai: Reverse punch, turn with lower body sweeping block.",
          "3.   Maegeri-chudan: Front kick to the body.",
          "4.   Surikomi-maegeri-chudan: One step front kick to the body.",
          "5.   Sokuto-fumikomi-hiza: Side edge stamping kick to the knee."
        ]
      },
      {
        "title": "RENRAKU-WAZA (Combination techniques)",
        "blocks": [
          "1. Maegeri-chudan-tobikomizuki-jodan: Front kick to the body, snap punch to the head.",
          "2. Surikomi-maegeri-chudan-tobikomizuki-jodan: One step front kick to the body, snap punch to the head.",
          "3. Maegeri-chudan-gyakuzuki-chudan: Front kick, reverse punch to the body.",
          "4. Surikomi-maegeri-chudan-gyakuzuki-chudan: One step front kick, reverse punch to the body."
        ]
      },
      {
        "title": "UKE (Blocking techniques)",
        "blocks": [
          "Performed from Junzuki-dachi",
          "1. Chudan-soto-uke-gyakuzuki: Body outer block, reverse punch.",
          "2. Chudan-uchi-uke-gyakuzuki: Body inner block, reverse punch.",
          "All blocks are performed with turning block (outer/inner), reverse punch."
        ]
      }
    ]
